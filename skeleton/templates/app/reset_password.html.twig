<!doctype html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Сброс пароля</title>
    <style>
        body { margin:0; background:#f5f7fa; font:16px/1.45 Georgia, "Times New Roman", serif; color:#1f2a36; }
        .wrap { max-width: 560px; margin: 28px auto; padding: 0 16px; }
        .card { background:#fff; border:1px solid #d4dbe2; border-radius:10px; padding:14px; }
        input, button { width:100%; padding:9px; margin-top:8px; border-radius:6px; border:1px solid #b9c5d0; font:15px Georgia, "Times New Roman", serif; }
        button { background:#1f4e79; border:0; color:#fff; cursor:pointer; }
        #msg { white-space: pre-wrap; min-height: 40px; margin-top: 12px; }
    </style>
</head>
<body>
<main class="wrap">
    <section class="card">
        <h2>Сброс пароля</h2>
        <p><a href="/">На страницу входа</a></p>
        <input id="token" placeholder="Токен" readonly>
        <input id="newPassword" type="password" placeholder="Новый пароль">
        <button id="submitBtn">Сменить пароль</button>
        <div id="msg">Готово.</div>
    </section>
</main>
<script>
const msg = document.getElementById('msg');
const tokenInput = document.getElementById('token');
const params = new URLSearchParams(window.location.search);
tokenInput.value = params.get('token') || '';

document.getElementById('submitBtn').addEventListener('click', async () => {
    const token = tokenInput.value;
    const newPassword = document.getElementById('newPassword').value;
    msg.textContent = 'Обновляем пароль...';

    const res = await fetch('/api/v1/auth/reset-password', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({token, newPassword})
    });

    const text = await res.text();
    try {
        const data = JSON.parse(text);
        msg.textContent = data.message || data.error || 'Готово';
    } catch (_) {
        msg.textContent = text || 'Готово';
    }
});
</script>
</body>
</html>
